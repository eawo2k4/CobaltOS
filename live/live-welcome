#!/usr/bin/bash
# Shown when the CobaltOS live system starts.
EXTRA=""
if [ -f /usr/share/cobaltos/live-nvidia ]; then
    EXTRA="\n<b>NVIDIA edition:</b> after installing, a blue \"MOK\" screen appears on the\nfirst reboot. Choose <i>Enroll MOK</i> and type the password <b>universalblue</b>\nso the NVIDIA driver works with Secure Boot.\n"
fi
yad \
    --title="Welcome to CobaltOS" \
    --window-icon=cobaltos \
    --image=cobaltos \
    --on-top --center --no-escape \
    --text-align=center --buttons-layout=center \
    --text="\n<span size='x-large'><b>Welcome to CobaltOS!</b></span>\n\nYou're running CobaltOS from the USB stick. Look around and check\nthat your graphics, sound and controllers work.\nNothing is saved, and games won't run as fast as on an installed system.\n${EXTRA}\nReady? Click <b>Install CobaltOS</b>. Everything is already on the USB stick,\nso no internet connection is needed.\n" \
    --button="Install CobaltOS:10" \
    --button="Try it first:0"
if [ $? -eq 10 ]; then
    liveinst &
    disown
fi

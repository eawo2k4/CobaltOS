{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/cobaltos/fastfetch-logo.txt",
    "color": { "1": "blue", "2": "white", "3": "cyan" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "cyan", "title": "blue" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
